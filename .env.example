# Copy to `.env` and fill in. Only GEMINI_API_KEY is required.

# --- Required ---
GEMINI_API_KEY=                 # Primary LLM (Gemini)

# --- Optional ---
GOOGLE_FACT_CHECK_API_KEY=      # Truth-table checking (uncited qualitative claims)
KAGGLE_USERNAME=                # Dataset search
KAGGLE_KEY=
UNPAYWALL_EMAIL=                # Open-access PDF lookup
SEMANTIC_SCHOLAR_API_KEY=

# --- Model tiers (defaults shown; override to change) ---
# LLM_MODEL_SMALL=gemini-2.5-flash-lite
# LLM_MODEL_MEDIUM=gemini-2.5-flash
# LLM_MODEL_STRONG=gemini-2.5-pro
