# Copy to `.env` and fill in. Only GEMINI_API_KEY is required.
#
# Everything here is also editable from the web UI at /config, which explains
# what each one unlocks and links to where to get it. The catalogue lives in
# src/asv/core/credentials.py — add a credential there, not here.

# --- Required ---
GEMINI_API_KEY=                 # Primary LLM (Gemini)

# --- Open access & indexes (free; the highest-yield section) ---
UNPAYWALL_EMAIL=                # Any real address, no signup. WITHOUT IT THE ENTIRE
                                #   UNPAYWALL STEP IS SKIPPED — the single biggest
                                #   source of open-access mirrors. Also the mailto for
                                #   the Crossref / OpenAlex polite pools.
ASV_CONTACT_EMAIL=              # Overrides UNPAYWALL_EMAIL for API politeness
SEMANTIC_SCHOLAR_API_KEY=       # Free, instant. The shared pool 429s under a 50-batch run
PUBMED_API_KEY=                 # Free with an NCBI account; raises 3 -> 10 req/s
CORE_API_KEY=                   # Free. ~300M OA papers from repositories — the mirror
                                #   layer that routes around publisher blocks.
                                #   Keyless CORE answers 429 to everything, so this is
                                #   skipped entirely without a key.

# --- Publisher text-mining keys (free registration; each converts 403s into full text) ---
WILEY_TDM_TOKEN=                # Sent as Wiley-TDM-Client-Token against api.wiley.com
ELSEVIER_API_KEY=               # Sent as X-ELS-APIKey
ELSEVIER_INSTTOKEN=             # Optional: carries institutional entitlement off-campus
SPRINGER_API_KEY=               # openaccess endpoint returns JATS full text

# --- Institutional access ---
EZPROXY_HOST=                   # e.g. proxy.lib.umich.edu. Blocked publisher URLs are
                                #   rewritten through it and retried in the logged-in
                                #   browser, so your SSO applies and ASV never handles a
                                #   credential. You remain responsible for your library's
                                #   terms of use.
EZPROXY_MAX_PER_RUN=40          # Hard cap on proxied fetches per run
INSTITUTIONAL_COOKIES=          # Escape hatch, superseded by the browser login flow.
                                #   JSON: {"www.jstor.org": {"SessionID": "abc123"}}

# --- Data repositories ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Model tiers (defaults shown; override to change) ---
# LLM_MODEL_SMALL=gemini-2.5-flash-lite
# LLM_MODEL_MEDIUM=gemini-2.5-flash
# LLM_MODEL_STRONG=gemini-2.5-pro

# --- Pipeline behaviour ---
# ASV_REFERENCE_CHECK=0         # Disable the Tier 0.6 bibliography audit
# ASV_KEEP_SOURCES=1            # Keep downloaded sources so the UI can show them
# ASV_ENABLE_DATA_GOV=1         # data.gov's CKAN API 404s as of 2026-09-23; off by default
# ASV_ENABLE_SCHOLAR=1          # Google Scholar browser search. Off: it is CAPTCHA-gated
                                #   and has never returned a usable link on this corpus

# --- HTTP layer (sourcefinder/polite_http.py) ---
# ASV_HTTP_MIN_INTERVAL=1.0     # Seconds between requests to the same host, process-wide
# ASV_HTTP_MAX_RETRIES=3        # Retries on 429/5xx, honouring Retry-After
# ASV_HTTP_CACHE=0              # Disable the on-disk response cache
# ASV_HTTP_CACHE_DIR=           # Default: runs/_cache/http
# ASV_HTTP_CACHE_TTL=604800     # Seconds a cached 2xx stays fresh (default 7 days)
